# Required: Soroush Plus bot token
BOT_TOKEN=replace_with_bot_token

# PostgreSQL credentials (use a long, unique password)
POSTGRES_DB=nepton
POSTGRES_USER=nepton
POSTGRES_PASSWORD=replace_with_a_long_random_password

# AI mode: auto, cloudflare, or rules
# rules works without an external AI provider, but has limited capabilities.
NEPTON_AI_MODE=auto
NEPTON_MODEL=@cf/zai-org/glm-4.7-flash
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional live web search
BRAVE_SEARCH_API_KEY=

# Optional monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Optional bot settings
NEPTON_ADMIN_CHAT_ID=
NEPTON_WORKERS=3
NEPTON_LOG_LEVEL=INFO

# Host port for Docker Compose
PORT=10000
