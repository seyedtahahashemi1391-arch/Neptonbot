# Required: Soroush Plus bot token
BOT_TOKEN=replace_with_bot_token

# PostgreSQL credentials. Use URL-safe characters; a random hex password is recommended.
POSTGRES_DB=nepton
POSTGRES_USER=nepton
POSTGRES_PASSWORD=replace_with_a_long_random_hex_password

# AI mode: auto, cloudflare, or rules
# auto falls back to deterministic replies when the model endpoint is unavailable.
# rules disables model calls and provides only basic deterministic responses.
NEPTON_AI_MODE=auto

# AI provider: cloudflare (default) or openai-compatible (local/private endpoint)
NEPTON_AI_PROVIDER=cloudflare
NEPTON_MODEL=@cf/zai-org/glm-4.7-flash
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# For a private OpenAI-compatible endpoint, use:
# NEPTON_AI_PROVIDER=openai-compatible
# NEPTON_AI_BASE_URL=http://host.docker.internal:11434/v1/chat/completions
# NEPTON_AI_API_KEY=
NEPTON_AI_BASE_URL=
NEPTON_AI_API_KEY=

# Live external data: auto or off.
# off prevents calls to Brave Search, Open-Meteo/wttr.in, and the GitHub market feed.
NEPTON_LIVE_DATA_MODE=auto
BRAVE_SEARCH_API_KEY=

# Soroush Plus API base URL; keep the official default unless an authorized endpoint is provided.
NEPTON_SOROUSH_API_BASE=https://api.splus.ir

# Optional monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Optional bot settings
NEPTON_ADMIN_CHAT_ID=
NEPTON_WORKERS=3
NEPTON_LOG_LEVEL=INFO

# Host port for Docker Compose
PORT=10000
